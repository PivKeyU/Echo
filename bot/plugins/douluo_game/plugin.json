{
  "schema_version": 2,
  "id": "douluo-game",
  "name": "斗罗大陆文字游戏",
  "version": "0.1.0",
  "description": "斗罗题材互动养成：魂力境界、武魂觉醒、魂环猎杀、魂骨暗器、宗门学院、斗魂场、魂兽讨伐、拍卖任务与碎片互通",
  "entry": "plugin",
  "enabled": true,
  "plugin_type": "builtin",
  "requires_restart": false,
  "permissions": [
    "telegram.commands",
    "telegram.callback_query",
    "telegram.read_group_messages",
    "telegram.read_private_messages",
    "telegram.send_group_messages",
    "telegram.send_private_messages",
    "web.routes",
    "web.static",
    "database.shared_read",
    "database.shared_write"
  ],
  "dependencies": {
    "python": []
  },
  "database": {
    "migrations_dir": "migrations"
  },
  "miniapp": {
    "path": "/plugins/douluo/app",
    "admin_path": "/plugins/douluo/admin",
    "label": "斗罗",
    "icon": "🔮",
    "bottom_nav_default": true
  }
}
